  */
 
+#include <stdio.h>
+
 #include <glib/gi18n.h>
 #include <gst/base/base.h>
 #include <gst/gst.h>
@@ -24,6 +26,7 @@
 #include "nd-codec-install.h"
 #include "nd-dummy-provider.h"
 #include "nd-meta-provider.h"
+#include "nd-meta-sink.h"
 #include "nd-nm-device-registry.h"
 #include "nd-pulseaudio.h"
 #include "nd-sink-list-model.h"
@@ -58,6 +61,16 @@ struct _NdWindow
 
   NdSink                *stream_sink;
 
+  /* Sink to re-connect to after the capture is lost to an X screen resize,
+   * and the timer driving that; see gnd_request_reconnect. */
+  NdSink                *reconnect_sink;
+  guint                  reconnect_id;
+  guint                  reconnect_wait;
+  guint                  reconnect_tries;
+  guint                  reconnect_idle_id;
+  guint                  reconnect_deadline;
+  gint64                 reconnect_last;
+
   GPtrArray             *sink_property_bindings;
 
   /* Template widgets */
@@ -143,6 +156,360 @@ nd_window_screencast_get_source (NdWindow * self)
   return g_steal_pointer (&src);
 }
 
+static void nd_window_connect_to_sink (NdWindow *self, NdSink *sink);
+
+/* Re-connecting after the capture is lost.
+ *
+ * An X screen resize can make ximagesrc reset its crop, which changes the
+ * caps on the already-negotiated intervideosink/intervideosrc pair and leaves
+ * it wedged: the stream keeps flowing but the sink shows a broken or black
+ * picture. Scaling before the bridge keeps that from being fatal, but the
+ * pipeline does not fully recover on its own, so tear the session down and
+ * bring it back up against the same sink.
+ */
+/* A discovered sink is an NdMetaSink wrapping whichever provider currently
+ * offers it. Tearing the session down can leave it with no backing sink --
+ * the peer has to be re-discovered first -- and starting a stream on it in
+ * that state asserts in nd_meta_sink_sink_start_stream. */
+static gboolean
+gnd_sink_is_connectable (NdSink *sink)
+{
+  if (ND_IS_META_SINK (sink))
+    return nd_meta_sink_get_sink (ND_META_SINK (sink)) != NULL;
+
+  return TRUE;
+}
+
+static gboolean
+gnd_reconnect_idle_cb (gpointer user_data)
+{
+  NdWindow *self = ND_WINDOW (user_data);
+
+  self->reconnect_idle_id = 0;
+
+  if (!self->reconnect_sink || self->stream_sink)
+    return G_SOURCE_REMOVE;
+
+  if (!gnd_sink_is_connectable (self->reconnect_sink))
+    return G_SOURCE_REMOVE;
+
+  g_message ("GND_X11_REGION_FILE: re-connecting after the capture was lost");
+  nd_window_connect_to_sink (self, self->reconnect_sink);
+
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+gnd_reconnect_cb (gpointer user_data)
+{
+  NdWindow *self = ND_WINDOW (user_data);
+  NdSinkState state;
+
+  if (self->stream_sink)
+    {
+      /* A failed attempt parks the sink in ERROR; drop it so it can reach
+       * DISCONNECTED and be started again. */
+      g_object_get (self->stream_sink, "state", &state, NULL);
+      if (state == ND_SINK_STATE_ERROR)
+        nd_sink_stop_stream (self->stream_sink);
+
+      return G_SOURCE_CONTINUE;
+    }
+
+  /* The sink reports DISCONNECTED before the P2P group has finished going
+   * away, and starting a new stream into that fails, so let it settle. */
+  if (self->reconnect_wait > 0)
+    {
+      self->reconnect_wait--;
+      return G_SOURCE_CONTINUE;
+    }
+
+  if (!self->reconnect_sink)
+    {
+      self->reconnect_id = 0;
+      return G_SOURCE_REMOVE;
+    }
+
+  /* Wait for the sink to be re-discovered before starting into it. */
+  if (!gnd_sink_is_connectable (self->reconnect_sink))
+    {
+      if (self->reconnect_deadline > 0)
+        {
+          self->reconnect_deadline--;
+          return G_SOURCE_CONTINUE;
+        }
+
+      g_warning ("GND_X11_REGION_FILE: sink was not re-discovered, giving up; "
+                 "re-connect it from the list");
+      self->reconnect_id = 0;
+      g_clear_object (&self->reconnect_sink);
+      return G_SOURCE_REMOVE;
+    }
+
+  self->reconnect_id = 0;
+
+  /* Connecting repopulates the sink list models and switches stack pages.
+   * Doing that straight from this timeout runs it while GTK still has layout
+   * pending -- it emits "snapshot without a current allocation" criticals and
+   * eventually crashes inside gtk_viewport_scroll_to. Hand it to an idle at
+   * the priority GTK uses for its own post-layout work instead. */
+  if (self->reconnect_idle_id == 0)
+    self->reconnect_idle_id = g_idle_add_full (G_PRIORITY_DEFAULT_IDLE,
+                                               gnd_reconnect_idle_cb,
+                                               self, NULL);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gnd_request_reconnect (NdWindow *self)
+{
+  if (!self)
+    return;
+
+  if (g_strcmp0 (g_getenv ("GND_X11_RECONNECT"), "0") == 0)
+    {
+      g_message ("GND_X11_RECONNECT=0: not re-connecting, the picture may stay broken");
+      return;
+    }
+
+  if (self->reconnect_id != 0)
+    return;                     /* already on its way */
+
+  if (!self->reconnect_sink || !self->stream_sink)
+    return;
+
+  /* Never reconnect in a tight loop: if the capture looks lost again right
+   * after a reconnect, something other than a one-off resize is wrong and
+   * cycling the session would only make it worse. */
+  if (self->reconnect_last != 0 &&
+      g_get_monotonic_time () - self->reconnect_last < 60 * G_TIME_SPAN_SECOND)
+    {
+      g_warning ("GND_X11_REGION_FILE: capture lost again within a minute of a "
+                 "re-connect; leaving the session alone");
+      return;
+    }
+
+  self->reconnect_last = g_get_monotonic_time ();
+
+  g_message ("GND_X11_REGION_FILE: capture lost to an X screen resize, re-connecting");
+
+  self->reconnect_tries = 3;
+  self->reconnect_wait = 6;     /* seconds of settle after DISCONNECTED */
+  self->reconnect_deadline = 60;/* seconds to wait for re-discovery */
+  nd_sink_stop_stream (self->stream_sink);
+  self->reconnect_id = g_timeout_add_seconds (1, gnd_reconnect_cb, self);
+}
+
+/* Parse "WxH+X+Y". Returns FALSE and leaves the outputs untouched if the
+ * string is not of that form or describes an empty region. */
+static gboolean
+gnd_parse_region (const gchar *region, guint *w, guint *h, guint *x, guint *y)
+{
+  guint pw = 0, ph = 0, px = 0, py = 0;
+  gchar tail = '\0';
+
+  if (!region || !*region)
+    return FALSE;
+
+  /* The trailing %c catches junk after the region, which sscanf would
+   * otherwise ignore. */
+  if (sscanf (region, "%ux%u+%u+%u%c", &pw, &ph, &px, &py, &tail) != 4)
+    return FALSE;
+
+  if (pw == 0 || ph == 0)
+    return FALSE;
+
+  *w = pw; *h = ph; *x = px; *y = py;
+  return TRUE;
+}
+
+static void
+gnd_apply_region (GstElement *src, guint w, guint h, guint x, guint y)
+{
+  g_object_set (src,
+                "startx", x,
+                "starty", y,
+                "endx", x + w - 1,
+                "endy", y + h - 1,
+                NULL);
+}
+
+/* Warn about a given region string only once, so a file we keep rejecting
+ * does not produce a message every second. */
+static gboolean
+gnd_warn_once (GstElement *src, const gchar *region)
+{
+  const gchar *warned = g_object_get_data (G_OBJECT (src), "gnd-region-warned");
+
+  if (g_strcmp0 (warned, region) == 0)
+    return FALSE;
+
+  g_object_set_data_full (G_OBJECT (src), "gnd-region-warned",
+                          g_strdup (region), g_free);
+  return TRUE;
+}
+
+/* Re-read $GND_X11_REGION_FILE and move the crop to match.
+ *
+ * ximagesrc reads startx/starty/endx/endy afresh for every frame, so the
+ * origin can be moved on a running pipeline. The frame size cannot: it was
+ * fixed when caps were negotiated, so a region of a different size is
+ * refused rather than passed on as a corrupt stream.
+ *
+ * This compares against the element's live properties rather than just the
+ * previous file contents, because ximagesrc resets the crop to full screen
+ * by itself whenever an X screen-size change leaves the old crop overshooting
+ * the root window (see gst_ximage_src_get_caps). Moving a display can shrink
+ * the root window and trigger exactly that, so re-asserting the region here
+ * is what puts the capture back on the intended display.
+ */
+static gboolean
+gnd_region_file_poll (gpointer user_data)
+{
+  GstElement *src = GST_ELEMENT (user_data);
+  NdWindow *window = g_object_get_data (G_OBJECT (src), "gnd-region-window");
+
+  /* Every connect builds a new capture bin with its own watcher. The bins
+   * from previous connects can outlive their session, and a stale one whose
+   * crop was reset would keep asking for reconnects forever. Only the newest
+   * element is allowed to act. */
+  if (window && g_object_get_data (G_OBJECT (window), "gnd-current-src") != src)
+    return G_SOURCE_REMOVE;
+  const gchar *path = g_object_get_data (G_OBJECT (src), "gnd-region-path");
+  guint exp_w = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (src), "gnd-region-w"));
+  guint exp_h = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (src), "gnd-region-h"));
+
+  g_autofree gchar *contents = NULL;
+  guint w, h, x, y, cur_x, cur_y, cur_endx, cur_endy;
+
+  if (!path)
+    return G_SOURCE_REMOVE;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return G_SOURCE_CONTINUE;  /* not written yet, or gone: keep the current crop */
+
+  g_strstrip (contents);
+
+  if (!gnd_parse_region (contents, &w, &h, &x, &y))
+    {
+      if (gnd_warn_once (src, contents))
+        g_warning ("GND_X11_REGION_FILE: \"%s\" is not of the form WxH+X+Y, ignoring",
+                   contents);
+      return G_SOURCE_CONTINUE;
+    }
+
+  if (w != exp_w || h != exp_h)
+    {
+      if (gnd_warn_once (src, contents))
+        g_warning ("GND_X11_REGION_FILE: cannot resize a running capture "
+                   "(%ux%u -> %ux%u); reconnect to pick up the new size",
+                   exp_w, exp_h, w, h);
+      return G_SOURCE_CONTINUE;
+    }
+
+  g_object_get (src,
+                "startx", &cur_x,
+                "starty", &cur_y,
+                "endx", &cur_endx,
+                "endy", &cur_endy,
+                NULL);
+
+  if (cur_x == x && cur_y == y &&
+      cur_endx == x + w - 1 && cur_endy == y + h - 1)
+    return G_SOURCE_CONTINUE;
+
+  if (cur_endx - cur_x + 1 != exp_w || cur_endy - cur_y + 1 != exp_h)
+    {
+      g_message ("GND_X11_REGION_FILE: capture was reset to %ux%u+%u+%u "
+                 "(X screen resize); restoring %ux%u+%u+%u",
+                 cur_endx - cur_x + 1, cur_endy - cur_y + 1, cur_x, cur_y, w, h, x, y);
+      gnd_apply_region (src, w, h, x, y);
+
+      /* Restoring the crop is not enough: the bridge downstream saw the size
+       * change and does not recover, so start a reconnect as well. */
+      gnd_request_reconnect (window);
+
+      return G_SOURCE_CONTINUE;
+    }
+
+  g_message ("GND_X11_REGION_FILE: moving capture to +%u+%u", x, y);
+  gnd_apply_region (src, w, h, x, y);
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+gnd_region_watch_stop (gpointer data, GObject *where_the_object_was)
+{
+  g_source_remove (GPOINTER_TO_UINT (data));
+}
+
+static void
+gnd_setup_x11_region (GstElement *src, NdWindow *window)
+{
+  const gchar *region = g_getenv ("GND_X11_REGION");
+  const gchar *region_file = g_getenv ("GND_X11_REGION_FILE");
+  guint w, h, x, y;
+
+  if (!src || !region || !*region)
+    return;
+
+  if (!gnd_parse_region (region, &w, &h, &x, &y))
+    {
+      g_warning ("GND_X11_REGION is set but is not of the form WxH+X+Y "
+                 "(got \"%s\"), capturing the whole screen instead", region);
+      return;
+    }
+
+  g_message ("GND_X11_REGION: cropping X11 capture to %ux%u+%u+%u", w, h, x, y);
+  gnd_apply_region (src, w, h, x, y);
+
+  /* Leave XDamage enabled: forcing full-frame reads here made the
+   * stream flicker and smear the cursor on a real sink. */
+  if (g_strcmp0 (g_getenv ("GND_X11_DAMAGE"), "0") == 0)
+    {
+      g_message ("GND_X11_DAMAGE=0: disabling XDamage");
+      g_object_set (src, "use-damage", FALSE, NULL);
+    }
+
+  if (region_file && *region_file)
+    {
+      guint id;
+
+      g_message ("GND_X11_REGION_FILE: tracking %s for repositioning", region_file);
+      g_object_set_data_full (G_OBJECT (src), "gnd-region-path",
+                              g_strdup (region_file), g_free);
+      /* Plain pointer: the window owns the pipeline this element lives in, and
+       * the pipeline is torn down when streaming stops, so src never outlives
+       * the window. */
+      g_object_set_data (G_OBJECT (src), "gnd-region-window", window);
+      g_object_set_data (G_OBJECT (window), "gnd-current-src", src);
+      /* The negotiated size. Compared against the file rather than against
+       * the element's current properties, which ximagesrc may have reset. */
+      g_object_set_data (G_OBJECT (src), "gnd-region-w", GUINT_TO_POINTER (w));
+      g_object_set_data (G_OBJECT (src), "gnd-region-h", GUINT_TO_POINTER (h));
+
+      /* The timeout holds src without a reference; drop it when src goes. */
+      id = g_timeout_add_seconds (1, gnd_region_file_poll, src);
+      g_object_weak_ref (G_OBJECT (src), gnd_region_watch_stop,
+                         GUINT_TO_POINTER (id));
+    }
+}
+
+/* Size of $GND_X11_REGION, if set and well formed. */
+static gboolean
+gnd_region_size (guint *w, guint *h)
+{
+  guint rw, rh, rx, ry;
+
+  if (!gnd_parse_region (g_getenv ("GND_X11_REGION"), &rw, &rh, &rx, &ry))
+    return FALSE;
+
+  *w = rw; *h = rh;
+  return TRUE;
+}
+
 static GstElement *
 sink_create_source_cb (NdWindow * self, NdSink * sink)
 {
@@ -153,7 +520,10 @@ sink_create_source_cb (NdWindow * self, NdSink * sink)
   bin = GST_BIN (gst_bin_new ("screencast source bin"));
   g_debug ("use x11: %d", self->use_x11);
   if (self->use_x11)
-    src = gst_element_factory_make ("ximagesrc", "X11 screencast source");
+    {
+      src = gst_element_factory_make ("ximagesrc", "X11 screencast source");
+      gnd_setup_x11_region (src, self);
+    }
   else
     src = nd_window_screencast_get_source (self);
 
@@ -172,7 +542,46 @@ sink_create_source_cb (NdWindow * self, NdSink * sink)
                 NULL);
   gst_bin_add (bin, dst);
 
-  if (self->screencast_type == ND_SCREEN_CAST_SOURCE_TYPE_VIRTUAL)
+  if (self->use_x11 && self->screencast_type != ND_SCREEN_CAST_SOURCE_TYPE_VIRTUAL)
+    {
+      guint rw = 0, rh = 0;
+
+      if (gnd_region_size (&rw, &rh))
+        {
+          GstElement *scale;
+
+          /* Pin what crosses the intervideosink/intervideosrc bridge to the
+           * region size. ximagesrc resets its crop to the full screen
+           * whenever an X screen resize leaves the old crop overshooting the
+           * root window, and that caps change on a running pair wedges it:
+           * the stream keeps flowing but the sink shows black for the rest of
+           * the session. Scaling here absorbs the change instead, so a resize
+           * costs at most a frame or two of the wrong picture before the
+           * region is re-asserted. */
+          scale = gst_element_factory_make ("videoscale", "region scale");
+          filter = gst_element_factory_make ("capsfilter", "regionfilter");
+          if (!scale || !filter)
+            g_error ("Error creating videoscale/capsfilter, missing dependency!");
+
+          caps = gst_caps_new_simple ("video/x-raw",
+                                      "width", G_TYPE_INT, (gint) rw,
+                                      "height", G_TYPE_INT, (gint) rh,
+                                      NULL);
+          g_object_set (filter, "caps", caps, NULL);
+          g_clear_pointer (&caps, gst_caps_unref);
+
+          gst_bin_add (bin, scale);
+          gst_bin_add (bin, filter);
+          gst_element_link_many (src, scale, filter, dst, NULL);
+
+          g_message ("GND_X11_REGION: pinning capture bridge to %ux%u", rw, rh);
+        }
+      else
+        {
+          gst_element_link_many (src, dst, NULL);
+        }
+    }
+  else if (self->screencast_type == ND_SCREEN_CAST_SOURCE_TYPE_VIRTUAL)
     {
       /* Initial caps for virtual display */
       caps = gst_caps_new_simple ("video/x-raw",
@@ -280,6 +689,18 @@ sink_notify_state_cb (NdWindow *self, GParamSpec *pspec, NdSink *sink)
       g_list_store_append (self->error_sink_list_model, self->stream_sink);
 
       gtk_stack_set_visible_child_name (self->step_stack, "error");
+
+      /* A reconnect attempt that failed: back off and try again rather than
+       * leaving the session sitting on the error page. */
+      if (self->reconnect_tries > 0 && self->reconnect_id == 0)
+        {
+          self->reconnect_tries--;
+          self->reconnect_wait = 6;
+          g_message ("GND_X11_REGION_FILE: re-connect attempt failed, %u left",
+                     self->reconnect_tries);
+          nd_sink_stop_stream (self->stream_sink);
+          self->reconnect_id = g_timeout_add_seconds (1, gnd_reconnect_cb, self);
+        }
       break;
 
     case ND_SINK_STATE_DISCONNECTED:
@@ -383,7 +804,6 @@ nd_screencast_init_cb (GObject      *source_object,
 static void
 find_sink_list_row_activated_cb (NdWindow *self, NdSinkRow *row, GtkListBox *sink_list)
 {
-  NdSink *sink;
 
   if (!self->use_x11 && !self->portal)
