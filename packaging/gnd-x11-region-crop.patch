From: local
Subject: [PATCH] app: allow cropping the X11 fallback capture to a region

When no ScreenCast portal is available (e.g. an XFCE/X11 session, where
xdg-desktop-portal-gnome cannot provide screencasting because Mutter is
not running), gnome-network-displays falls back to a bare ximagesrc that
grabs the whole root window, so the sink can only ever mirror.

Honour $GND_X11_REGION ("WxH+X+Y") to crop that capture to a sub-region
of the root window. Combined with a virtual display (evdi, or any real
second output), this gives a real extended display over Miracast instead
of a mirror.

$GND_X11_REGION_FILE names a file that is re-read once a second while
streaming. ximagesrc reads startx/starty/endx/endy on every frame, so the
capture can be moved to follow a display the user repositions in arandr
or xfce4-display-settings, with no interruption to the session. Only the
origin can move that way: the caps are negotiated once, so a region of a
different size is refused rather than passed on as a corrupt stream.

Two things make that safe in practice:

The poll compares against the element's live properties, not just the
previous file contents, because ximagesrc resets its crop to the full
screen whenever an X screen resize leaves the old crop overshooting the
root window (gst_ximage_src_get_caps). Moving a display shrinks the root
window often enough to hit that.

The capture is also scaled to a fixed size before intervideosink, so what
crosses the intervideosink/intervideosrc bridge never changes size. That
pair negotiates caps once; letting the reset above change them wedges it,
and the sink then shows black for the rest of the session while the
stream keeps flowing.

XDamage is deliberately left at its default (enabled). Forcing it off
here made the encoded stream flicker badly and smear the cursor on a real
Miracast sink, while an identical uncropped capture was clean; the full
frame reads interact badly with the rest of the pipeline. $GND_X11_DAMAGE=0
disables it for anyone who wants to experiment.
--- a/src/app/nd-window.c
+++ b/src/app/nd-window.c
@@ -16,6 +16,8 @@
  * along with this program.  If not, see <http://www.gnu.org/licenses/>.
  */
 
+#include <stdio.h>
+
 #include <glib/gi18n.h>
 #include <gst/base/base.h>
 #include <gst/gst.h>
@@ -143,6 +145,194 @@ nd_window_screencast_get_source (NdWindow * self)
   return g_steal_pointer (&src);
 }
 
+/* Parse "WxH+X+Y". Returns FALSE and leaves the outputs untouched if the
+ * string is not of that form or describes an empty region. */
+static gboolean
+gnd_parse_region (const gchar *region, guint *w, guint *h, guint *x, guint *y)
+{
+  guint pw = 0, ph = 0, px = 0, py = 0;
+  gchar tail = '\0';
+
+  if (!region || !*region)
+    return FALSE;
+
+  /* The trailing %c catches junk after the region, which sscanf would
+   * otherwise ignore. */
+  if (sscanf (region, "%ux%u+%u+%u%c", &pw, &ph, &px, &py, &tail) != 4)
+    return FALSE;
+
+  if (pw == 0 || ph == 0)
+    return FALSE;
+
+  *w = pw; *h = ph; *x = px; *y = py;
+  return TRUE;
+}
+
+static void
+gnd_apply_region (GstElement *src, guint w, guint h, guint x, guint y)
+{
+  g_object_set (src,
+                "startx", x,
+                "starty", y,
+                "endx", x + w - 1,
+                "endy", y + h - 1,
+                NULL);
+}
+
+/* Warn about a given region string only once, so a file we keep rejecting
+ * does not produce a message every second. */
+static gboolean
+gnd_warn_once (GstElement *src, const gchar *region)
+{
+  const gchar *warned = g_object_get_data (G_OBJECT (src), "gnd-region-warned");
+
+  if (g_strcmp0 (warned, region) == 0)
+    return FALSE;
+
+  g_object_set_data_full (G_OBJECT (src), "gnd-region-warned",
+                          g_strdup (region), g_free);
+  return TRUE;
+}
+
+/* Re-read $GND_X11_REGION_FILE and move the crop to match.
+ *
+ * ximagesrc reads startx/starty/endx/endy afresh for every frame, so the
+ * origin can be moved on a running pipeline. The frame size cannot: it was
+ * fixed when caps were negotiated, so a region of a different size is
+ * refused rather than passed on as a corrupt stream.
+ *
+ * This compares against the element's live properties rather than just the
+ * previous file contents, because ximagesrc resets the crop to full screen
+ * by itself whenever an X screen-size change leaves the old crop overshooting
+ * the root window (see gst_ximage_src_get_caps). Moving a display can shrink
+ * the root window and trigger exactly that, so re-asserting the region here
+ * is what puts the capture back on the intended display.
+ */
+static gboolean
+gnd_region_file_poll (gpointer user_data)
+{
+  GstElement *src = GST_ELEMENT (user_data);
+  const gchar *path = g_object_get_data (G_OBJECT (src), "gnd-region-path");
+  guint exp_w = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (src), "gnd-region-w"));
+  guint exp_h = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (src), "gnd-region-h"));
+
+  g_autofree gchar *contents = NULL;
+  guint w, h, x, y, cur_x, cur_y, cur_endx, cur_endy;
+
+  if (!path)
+    return G_SOURCE_REMOVE;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return G_SOURCE_CONTINUE;  /* not written yet, or gone: keep the current crop */
+
+  g_strstrip (contents);
+
+  if (!gnd_parse_region (contents, &w, &h, &x, &y))
+    {
+      if (gnd_warn_once (src, contents))
+        g_warning ("GND_X11_REGION_FILE: \"%s\" is not of the form WxH+X+Y, ignoring",
+                   contents);
+      return G_SOURCE_CONTINUE;
+    }
+
+  if (w != exp_w || h != exp_h)
+    {
+      if (gnd_warn_once (src, contents))
+        g_warning ("GND_X11_REGION_FILE: cannot resize a running capture "
+                   "(%ux%u -> %ux%u); reconnect to pick up the new size",
+                   exp_w, exp_h, w, h);
+      return G_SOURCE_CONTINUE;
+    }
+
+  g_object_get (src,
+                "startx", &cur_x,
+                "starty", &cur_y,
+                "endx", &cur_endx,
+                "endy", &cur_endy,
+                NULL);
+
+  if (cur_x == x && cur_y == y &&
+      cur_endx == x + w - 1 && cur_endy == y + h - 1)
+    return G_SOURCE_CONTINUE;
+
+  if (cur_endx - cur_x + 1 != exp_w || cur_endy - cur_y + 1 != exp_h)
+    g_message ("GND_X11_REGION_FILE: capture was reset to %ux%u+%u+%u "
+               "(X screen resize); restoring %ux%u+%u+%u",
+               cur_endx - cur_x + 1, cur_endy - cur_y + 1, cur_x, cur_y, w, h, x, y);
+  else
+    g_message ("GND_X11_REGION_FILE: moving capture to +%u+%u", x, y);
+
+  gnd_apply_region (src, w, h, x, y);
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+gnd_region_watch_stop (gpointer data, GObject *where_the_object_was)
+{
+  g_source_remove (GPOINTER_TO_UINT (data));
+}
+
+static void
+gnd_setup_x11_region (GstElement *src)
+{
+  const gchar *region = g_getenv ("GND_X11_REGION");
+  const gchar *region_file = g_getenv ("GND_X11_REGION_FILE");
+  guint w, h, x, y;
+
+  if (!src || !region || !*region)
+    return;
+
+  if (!gnd_parse_region (region, &w, &h, &x, &y))
+    {
+      g_warning ("GND_X11_REGION is set but is not of the form WxH+X+Y "
+                 "(got \"%s\"), capturing the whole screen instead", region);
+      return;
+    }
+
+  g_message ("GND_X11_REGION: cropping X11 capture to %ux%u+%u+%u", w, h, x, y);
+  gnd_apply_region (src, w, h, x, y);
+
+  /* Leave XDamage enabled: forcing full-frame reads here made the
+   * stream flicker and smear the cursor on a real sink. */
+  if (g_strcmp0 (g_getenv ("GND_X11_DAMAGE"), "0") == 0)
+    {
+      g_message ("GND_X11_DAMAGE=0: disabling XDamage");
+      g_object_set (src, "use-damage", FALSE, NULL);
+    }
+
+  if (region_file && *region_file)
+    {
+      guint id;
+
+      g_message ("GND_X11_REGION_FILE: tracking %s for repositioning", region_file);
+      g_object_set_data_full (G_OBJECT (src), "gnd-region-path",
+                              g_strdup (region_file), g_free);
+      /* The negotiated size. Compared against the file rather than against
+       * the element's current properties, which ximagesrc may have reset. */
+      g_object_set_data (G_OBJECT (src), "gnd-region-w", GUINT_TO_POINTER (w));
+      g_object_set_data (G_OBJECT (src), "gnd-region-h", GUINT_TO_POINTER (h));
+
+      /* The timeout holds src without a reference; drop it when src goes. */
+      id = g_timeout_add_seconds (1, gnd_region_file_poll, src);
+      g_object_weak_ref (G_OBJECT (src), gnd_region_watch_stop,
+                         GUINT_TO_POINTER (id));
+    }
+}
+
+/* Size of $GND_X11_REGION, if set and well formed. */
+static gboolean
+gnd_region_size (guint *w, guint *h)
+{
+  guint rw, rh, rx, ry;
+
+  if (!gnd_parse_region (g_getenv ("GND_X11_REGION"), &rw, &rh, &rx, &ry))
+    return FALSE;
+
+  *w = rw; *h = rh;
+  return TRUE;
+}
+
 static GstElement *
 sink_create_source_cb (NdWindow * self, NdSink * sink)
 {
@@ -153,7 +343,10 @@ sink_create_source_cb (NdWindow * self, NdSink * sink)
   bin = GST_BIN (gst_bin_new ("screencast source bin"));
   g_debug ("use x11: %d", self->use_x11);
   if (self->use_x11)
-    src = gst_element_factory_make ("ximagesrc", "X11 screencast source");
+    {
+      src = gst_element_factory_make ("ximagesrc", "X11 screencast source");
+      gnd_setup_x11_region (src);
+    }
   else
     src = nd_window_screencast_get_source (self);
 
@@ -172,7 +365,46 @@ sink_create_source_cb (NdWindow * self, NdSink * sink)
                 NULL);
   gst_bin_add (bin, dst);
 
-  if (self->screencast_type == ND_SCREEN_CAST_SOURCE_TYPE_VIRTUAL)
+  if (self->use_x11 && self->screencast_type != ND_SCREEN_CAST_SOURCE_TYPE_VIRTUAL)
+    {
+      guint rw = 0, rh = 0;
+
+      if (gnd_region_size (&rw, &rh))
+        {
+          GstElement *scale;
+
+          /* Pin what crosses the intervideosink/intervideosrc bridge to the
+           * region size. ximagesrc resets its crop to the full screen
+           * whenever an X screen resize leaves the old crop overshooting the
+           * root window, and that caps change on a running pair wedges it:
+           * the stream keeps flowing but the sink shows black for the rest of
+           * the session. Scaling here absorbs the change instead, so a resize
+           * costs at most a frame or two of the wrong picture before the
+           * region is re-asserted. */
+          scale = gst_element_factory_make ("videoscale", "region scale");
+          filter = gst_element_factory_make ("capsfilter", "regionfilter");
+          if (!scale || !filter)
+            g_error ("Error creating videoscale/capsfilter, missing dependency!");
+
+          caps = gst_caps_new_simple ("video/x-raw",
+                                      "width", G_TYPE_INT, (gint) rw,
+                                      "height", G_TYPE_INT, (gint) rh,
+                                      NULL);
+          g_object_set (filter, "caps", caps, NULL);
+          g_clear_pointer (&caps, gst_caps_unref);
+
+          gst_bin_add (bin, scale);
+          gst_bin_add (bin, filter);
+          gst_element_link_many (src, scale, filter, dst, NULL);
+
+          g_message ("GND_X11_REGION: pinning capture bridge to %ux%u", rw, rh);
+        }
+      else
+        {
+          gst_element_link_many (src, dst, NULL);
+        }
+    }
+  else if (self->screencast_type == ND_SCREEN_CAST_SOURCE_TYPE_VIRTUAL)
     {
       /* Initial caps for virtual display */
       caps = gst_caps_new_simple ("video/x-raw",
