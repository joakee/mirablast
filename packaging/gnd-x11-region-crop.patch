@@ -408,7 +828,12 @@ find_sink_list_row_activated_cb (NdWindow *self, NdSinkRow *row, GtkListBox *sin
 
   g_assert (ND_IS_SINK_ROW (row));
 
-  sink = nd_sink_row_get_sink (row);
+  nd_window_connect_to_sink (self, nd_sink_row_get_sink (row));
+}
+
+static void
+nd_window_connect_to_sink (NdWindow *self, NdSink *sink)
+{
   self->stream_sink = nd_sink_start_stream (sink);
 
   if (!self->stream_sink)
@@ -465,6 +890,8 @@ find_sink_list_row_activated_cb (NdWindow *self, NdSinkRow *row, GtkListBox *sin
 
   g_object_set (self->meta_provider, "discover", FALSE, NULL);
   g_list_store_append (self->connect_sink_list_model, self->stream_sink);
+
+  g_set_object (&self->reconnect_sink, sink);
 }
 
 static void
@@ -556,6 +983,10 @@ gnome_nd_window_dispose (GObject *obj)
 {
   NdWindow *self = ND_WINDOW (obj);
 
+  g_clear_handle_id (&self->reconnect_id, g_source_remove);
+  g_clear_handle_id (&self->reconnect_idle_id, g_source_remove);
+  g_clear_object (&self->reconnect_sink);
+
 #ifdef HAVE_AVAHI
   g_object_run_dispose (G_OBJECT (self->avahi_client));
 #endif
